# PostgreSQL (development values only; replace them outside local development)
POSTGRES_DB=bioverse
POSTGRES_USER=bioverse
POSTGRES_PASSWORD=bioverse_dev
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql+psycopg://bioverse:bioverse_dev@localhost:5433/bioverse
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
PUBCHEM_TIMEOUT_SECONDS=10
PUBCHEM_RETRY_COUNT=2
PUBCHEM_RETRY_BACKOFF_SECONDS=0.25
PUBCHEM_MAX_SEARCH_RESULTS=10
PUBCHEM_MAX_STRUCTURE_BYTES=5000000
COMPOUND_CACHE_TTL_SECONDS=900
COMPOUND_CACHE_MAX_ENTRIES=256
RCSB_TIMEOUT_SECONDS=15
RCSB_RETRY_COUNT=2
RCSB_RETRY_BACKOFF_SECONDS=0.5
RCSB_MAX_SEARCH_RESULTS=10
RCSB_MAX_JSON_BYTES=5000000
RCSB_MAX_STRUCTURE_BYTES=25000000
RCSB_CACHE_TTL_SECONDS=3600
RCSB_CACHE_MAX_ENTRIES=128

# Frontend server (never exposed as a browser scientific-source URL)
FRONTEND_PORT=3000
BIOVERSE_API_BASE_URL=http://localhost:8000
